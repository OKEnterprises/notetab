{
  "manifest_version": 3,
  "name": "Tabmargin",
  "version": "2.5.0",
  "description": "Turn your new tab page into a minimalist notepad with persistent storage",

  "icons": {
    "48": "icons/notes.svg",
    "96": "icons/notes.svg"
  },

  "action": {
    "default_icon": {
      "48": "icons/notes.svg",
      "96": "icons/notes.svg"
    },
    "default_title": "Tabmargin Settings",
    "default_popup": "popup.html"
  },

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://api.tabmargin.com/*",
    "https://*.supabase.co/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "notetab@example.com",
      "strict_min_version": "120.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "personalCommunications"
        ]
      }
    }
  }
}
